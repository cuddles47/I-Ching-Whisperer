# API Configuration
API_PREFIX=/api/v1
PROJECT_NAME="API Giải Quẻ Kinh Dịch"
DEBUG=True

# LLM Provider (openai or huggingface)
LLM_PROVIDER=huggingface
# Enable optimizations for local models
LLM_OPTIMIZE=True

# OpenAI Configuration (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4

# Hugging Face Configuration (only needed if LLM_PROVIDER=huggingface)
# Select a model appropriate for your hardware
# Smaller models for limited resources:
HF_MODEL_NAME=microsoft/phi-2
# Medium sized models:
# HF_MODEL_NAME=TheBloke/Mistral-7B-Instruct-v0.2-GPTQ
# Larger models (requires more GPU memory):
# HF_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct

# Device options: "cuda" for NVIDIA GPU, "mps" for Apple Silicon, "cpu" for CPU only, or leave empty for auto-detect
HF_DEVICE=

# Generation parameters
HF_MAX_LENGTH=2048
HF_MAX_NEW_TOKENS=1024
HF_TEMPERATURE=0.7
HF_TOP_P=0.9

# Optimization settings (only used if LLM_OPTIMIZE=True)
HF_USE_BETTER_TRANSFORMER=True
HF_USE_FLASH_ATTENTION=True
HF_USE_8BIT=True
HF_USE_4BIT=False
HF_BATCH_SIZE=1
